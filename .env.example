# Copiá este archivo a ".env" (sin ".example") y completá lo que uses.
# El .env NUNCA se sube a GitHub (agregalo a .gitignore).

# Opcional — activa la Voz IA (ElevenLabs) en la pestaña "Voces".
# Conseguila en https://elevenlabs.io -> creá una cuenta -> Profile -> API Keys.
# Sin esta key, VOXZ funciona igual pero con la voz del navegador.
ELEVENLABS_API_KEY=

# Opcional — sube el límite de conexiones simultáneas a TikTok LIVE.
# Conseguila gratis en https://www.eulerstream.com
EULER_API_KEY=
